{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "loom-spec-view",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "loom-spec", "dev"],
      "port": 7777
    },
    {
      "name": "loom-spec-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "packages/loom-spec/dist/cli/index.js",
        "view",
        "--root",
        "examples/todo-app"
      ],
      "port": 7777
    },
    {
      "name": "loom-export-verify",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "/tmp/loom-export-verify"],
      "port": 8765
    }
  ]
}
